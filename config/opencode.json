{
  "model": "kimi-code-plan-global/kimi-for-coding",
  "default_agent": "orchestrator",
  "update": "disable",
  "share": "disabled",
  "formatter": {
    "typstyle": {
      "command": ["typstyle", "--inplace", "$FILE"],
      "extensions": [".typ"]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "zotero": {
        "type": "remote",
        "url": "https://zotero.sgh.ng/mcp"
      }
    }
  }
}
