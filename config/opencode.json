{
  "model": "minimax-cn-coding-plan/MiniMax-M3",
  "default_agent": "orchestrator",
  "update": "disable",
  "share": "disabled",
  "references": {
    "lab-reference": {
      "path": "../reference",
      "description": "Lab reference shelf, read on request. style/ holds the corpus-grounded style system (zen, handbook, manual) for psychometric prose. reference.docx is the pandoc reference doc every Word export passes via --reference-doc"
    }
  },
  "formatter": {
    "typstyle": {
      "command": [
        "typstyle",
        "--inplace",
        "$FILE"
      ],
      "extensions": [
        ".typ"
      ]
    }
  },
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "zotero": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "zotero-mcp-server",
          "zotero-mcp"
        ],
        "environment": {
          "ZOTERO_LOCAL": "true",
          "ZOTERO_EMBEDDING_MODEL": "openai",
          "OPENAI_API_KEY": "{env:OPENAI_API_KEY}",
          "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
          "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
          "ZOTERO_LIBRARY_ID": "9358581",
          "ZOTERO_LIBRARY_TYPE": "user"
        },
        "timeout": {
          "startup": 120000
        }
      }
    }
  }
}
