#!/usr/bin/env bash
# lab -- spin up the full ensemble in one tmux session: three panes, three
# roles, all attached to the project in the current directory. Re-running
# attaches to the existing session.
set -euo pipefail
HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION="${LAB_SESSION:-abstract}"

command -v tmux >/dev/null || {
  echo "lab: tmux not found (brew install tmux)" >&2
  exit 1
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# orchestrator left, engineer + librarian stacked right
tmux new-session -d -s "$SESSION" -c "$PWD" "$HARNESS_DIR/bin/orchestrator"
tmux split-window -h -t "$SESSION:0" -c "$PWD" "$HARNESS_DIR/bin/engineer"
tmux split-window -v -t "$SESSION:0.1" -c "$PWD" "$HARNESS_DIR/bin/librarian"
exec tmux attach -t "$SESSION"
