#!/usr/bin/env bash
# lab -- spin up the full ensemble in one tmux session: three panes (one per
# lab role), all attached to the project in the current directory. Re-running
# attaches to the existing session when its layout is already correct;
# otherwise the session is recreated. Agent conversation memory lives in
# .pi/sessions/<role>.jsonl and survives tmux recreations.
set -euo pipefail
HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION="${LAB_SESSION:-abstract}"

command -v tmux >/dev/null || {
  echo "lab: tmux not found (brew install tmux)" >&2
  exit 1
}

# Recreate the session if it doesn't already have the expected 3-pane layout.
if tmux has-session -t "$SESSION" 2>/dev/null; then
  count=$(tmux list-panes -t "$SESSION" | wc -l | tr -d ' ')
  if [ "$count" = "3" ]; then
    exec tmux attach -t "$SESSION"
  fi
  echo "lab: recreating session (layout stale; agent memory preserved in .pi/sessions/)" >&2
  tmux kill-session -t "$SESSION"
fi

# orchestrator left, engineer + librarian stacked right
tmux new-session -d -s "$SESSION" -c "$PWD" "$HARNESS_DIR/bin/orchestrator"
tmux split-window -h -t "$SESSION:0" -c "$PWD" "$HARNESS_DIR/bin/engineer"
tmux split-window -v -t "$SESSION:0.1" -c "$PWD" "$HARNESS_DIR/bin/librarian"

exec tmux attach -t "$SESSION"