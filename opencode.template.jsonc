{
  "$schema": "https://opencode.ai/config.json",

  // The kernel is not mounted from config: v2 accepts an instructions array
  // but never loads it. The kernel rides an AGENTS.md symlink at the
  // research root; v2 loads every AGENTS.md from the workspace toward $HOME.
  // abstract init checks that walk and prints the ln -s fix when missing.

  // The mounted skill library. staging/ is deliberately not listed.
  "skills": ["~/dev/abstract/skills"],

  // No "model" key on purpose: the session model is the user's choice.
  // Sidekick pins live in the agent markdown files.

  "mcp": {
    "abstract": {
      "type": "remote",
      "url": "https://abstract.sgh.ng/mcp"
    },
    "zotero": {
      "type": "remote",
      "url": "https://zotero.sgh.ng/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    }
  },

  // Sidekicks mount as markdown files: init symlinks ~/dev/abstract/agents/
  // into the project's .opencode/agents/ (one symlink per file). Model pins
  // live in the agent files: deepseek-v4.1-flash for every sidekick except
  // the statistician, pinned to kimi k3-256k, whose rulings steer the cheap
  // executors.

  // Unpinned subagents inherit the session model, which is the expensive
  // orchestrator. Same-ID overrides pin the built-ins to the executor;
  // scalars merge, so their prompts and tools stay intact.
  "agents": {
    "general": { "model": "deepseek/deepseek-flash" },
    "explore": { "model": "deepseek/deepseek-flash" }
  }
}
